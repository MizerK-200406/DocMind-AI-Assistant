# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCMIND
# ==============================================================================

# LLM / NVIDIA NIM API
NVIDIA_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=2048

# Cơ sở dữ liệu SQLite
DB_PATH=docmind.db

# Vector Store & Embedding Model
CHROMA_PATH=chroma_data
CHROMA_COLLECTION=docmind_chunks
EMBEDDING_MODEL=BAAI/bge-M3

# RAG Pipeline
RAG_TOP_K=5
RAG_MIN_SCORE=0.5

# Tài liệu & Chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=200